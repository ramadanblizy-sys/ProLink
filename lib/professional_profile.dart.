import 'package:flutter/material.dart';
import 'professional.dart';

class ProfessionalProfile extends StatelessWidget {
  final Professional professional;

  const ProfessionalProfile({
    super.key,
    required this.professional,
  });

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Perfil profissional'),
        backgroundColor: const Color(0xFF123B65),
        foregroundColor: Colors.white,
      ),

      body: SingleChildScrollView(
        padding: const EdgeInsets.all(20),
        child: Column(
          children: [
            const CircleAvatar(
              radius: 55,
              backgroundColor: Color(0xFFE1EBF5),
              child: Icon(
                Icons.person,
                size: 65,
                color: Color(0xFF123B65),
              ),
            ),

            const SizedBox(height: 15),

            Text(
              professional.name,
              style: const TextStyle(
                fontSize: 23,
                fontWeight: FontWeight.bold,
              ),
            ),

            const SizedBox(height: 8),

            Text(
              professional.profession,
              style: const TextStyle(fontSize: 17),
            ),

            const SizedBox(height: 25),

            profileItem(
              Icons.phone,
              'Telefone',
              professional.phone,
            ),

            profileItem(
              Icons.location_on,
              'Província',
              professional.province,
            ),

            profileItem(
              Icons.map,
              'Distrito',
              professional.district,
            ),

            profileItem(
              Icons.home,
              'Bairro',
              professional.neighborhood,
            ),

            profileItem(
              Icons.work,
              'Experiência',
              professional.experience.isEmpty
                  ? 'Não informada'
                  : professional.experience,
            ),

            const SizedBox(height: 15),

            const Align(
              alignment: Alignment.centerLeft,
              child: Text(
                'Sobre o profissional',
                style: TextStyle(
                  fontSize: 18,
                  fontWeight: FontWeight.bold,
                ),
              ),
            ),

            const SizedBox(height: 8),

            Align(
              alignment: Alignment.centerLeft,
              child: Text(
                professional.description.isEmpty
                    ? 'Sem descrição disponível.'
                    : professional.description,
              ),
            ),

            const SizedBox(height: 20),

            const Align(
              alignment: Alignment.centerLeft,
              child: Text(
                'Fotografias dos trabalhos realizados',
                style: TextStyle(
                  fontSize: 18,
                  fontWeight: FontWeight.bold,
                ),
              ),
            ),

            const SizedBox(height: 10),

            if (professional.workPhotos.isEmpty)
              const Text(
                'Nenhuma fotografia adicionada.',
              )
            else
              Wrap(
                spacing: 10,
                runSpacing: 10,
                children: professional.workPhotos.map(
                  (photo) => Image.network(
                    photo,
                    width: 120,
                    height: 120,
                    fit: BoxFit.cover,
                  ),
                ).toList(),
              ),

            const SizedBox(height: 25),

            SizedBox(
              width: double.infinity,
              height: 50,
              child: ElevatedButton.icon(
                onPressed: () {
                  ScaffoldMessenger.of(context).showSnackBar(
                    SnackBar(
                      content: Text(
                        'Contacte ${professional.name} '
                        'pelo número ${professional.phone}.',
                      ),
                    ),
                  );
                },
                icon: const Icon(Icons.phone),
                label: const Text('Contactar profissional'),
                style: ElevatedButton.styleFrom(
                  backgroundColor: const Color(0xFF123B65),
                  foregroundColor: Colors.white,
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget profileItem(
    IconData icon,
    String title,
    String value,
  ) {
    return ListTile(
      leading: Icon(
        icon,
        color: const Color(0xFF123B65),
      ),
      title: Text(title),
      subtitle: Text(value),
    );
  }
}
