import 'package:flutter/material.dart';
import 'conversation.dart';

class ChatListPage extends StatelessWidget {
  const ChatListPage({super.key});

  final List<Conversation> conversations = const [];

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Minhas conversas'),
        backgroundColor: const Color(0xFF123B65),
        foregroundColor: Colors.white,
      ),
      body: conversations.isEmpty
          ? const Center(
              child: Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  Icon(
                    Icons.chat_bubble_outline,
                    size: 70,
                    color: Colors.grey,
                  ),
                  SizedBox(height: 15),
                  Text(
                    'Ainda não tem conversas.',
                    style: TextStyle(fontSize: 18),
                  ),
                  SizedBox(height: 8),
                  Text(
                    'As suas mensagens aparecerão aqui.',
                  ),
                ],
              ),
            )
          : ListView.builder(
              itemCount: conversations.length,
              itemBuilder: (context, index) {
                final conversation = conversations[index];

                return ListTile(
                  leading: const CircleAvatar(
                    child: Icon(Icons.person),
                  ),
                  title: Text(conversation.professionalName),
                  subtitle: Text(conversation.lastMessage),
                  trailing: conversation.unreadMessages > 0
                      ? CircleAvatar(
                          radius: 12,
                          child: Text(
                            '${conversation.unreadMessages}',
                            style: const TextStyle(fontSize: 12),
                          ),
                        )
                      : null,
                );
              },
            ),
    );
  }
}
